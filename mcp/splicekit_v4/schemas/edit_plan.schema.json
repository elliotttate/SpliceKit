{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EditPlan v1 (half-open source and timeline ranges)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "sequence_id",
    "base_revision",
    "frame_rate",
    "scope",
    "sources",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "frame_rate": {
      "$ref": "#/$defs/time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ids",
        "allow_ripple"
      ],
      "properties": {
        "target_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allow_ripple": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration",
          "frame_rate",
          "words"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "$ref": "#/$defs/time"
          },
          "frame_rate": {
            "$ref": "#/$defs/time"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "start",
                "end"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "$ref": "#/$defs/time"
                },
                "end": {
                  "$ref": "#/$defs/time"
                }
              }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "capability",
          "args"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "cut",
              "title",
              "effect",
              "parameter",
              "transition"
            ]
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "cut"
                }
              }
            },
            "then": {
              "properties": {
                "args": {
                  "required": [
                    "source_id",
                    "source_range",
                    "word_ids"
                  ],
                  "properties": {
                    "source_id": {
                      "type": "string"
                    },
                    "source_range": {
                      "$ref": "#/$defs/range"
                    },
                    "word_ids": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 0
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        }
      }
    }
  }
}

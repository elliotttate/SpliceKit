  "manual_cases": [
    {
      "method": "v4.color.inspect",
      "steps": [
        "Inspect a Board, Wheels, Curves, Hue-Sat and Custom LUT fixture instance at a nonzero clip-local time.",
        "Compare native instance IDs and full discovered parameter trees with exported FCPXML."
      ],
      "expected_readback": [
        "Exact correction instance and typed path tree; custom curve writes unsupported; preview metadata remains unknown until measured."
      ],
      "undo_check": "Read only: assert identical before/after native XML."
    },
    {
      "method": "v4.color.apply_adjustment",
      "steps": [
        "Create each family using the full catalog effect_id; rediscover its fileUUID.",
        "Bind exposure/saturation/wheel/LUT logical names to that exact instance tree. Write a typed value and inspect independently.",
        "Attempt a custom Curves/Hue-Sat control-point write; require refusal with no state change."
      ],
      "expected_readback": [
        "One new correction identity after creation; requested native values after adjustment; no sibling correction changed."
      ],
      "undo_check": "Owned undo must restore full effect order, identities and all parameter/keyframe data. Create and adjustment are separate undo cycles."
    },
    {
      "method": "v4.audio.inspect",
      "steps": [
        "Use a trimmed and retimed AV fixture with native audio identifier 0.",
        "Read two times with different automation values and compare to FCPXML."
      ],
      "expected_readback": [
        "Native linear gain, converted dB, local time, exact keyframe count/presence, both fades, role UID and channel enable map."
      ],
      "undo_check": "Read only: no semantic or revision change."
    },
    {
      "method": "v4.audio.set_gain",
      "steps": [
        "Set -6 dB constant on an unanimated fixture.",
        "Insert a keyframe at component-local 11s; verify a different-time key survives.",
        "Attempt constant write on animated gain; require refusal."
      ],
      "expected_readback": [
        "Native linear gain near 0.501187233627; exact-time keyframe presence."
      ],
      "undo_check": "Compare full gain curve plus fades, routing, role and other clip state after owned undo; listen to a native mix excerpt separately."
    },
    {
      "method": "v4.audio.fade",
      "steps": [
        "Set each edge to 15/30s; independently read native durations.",
        "Set duration zero to remove one edge; ensure the other edge survives."
      ],
      "expected_readback": [
        "Native duration and requested edge; no claimed fade-type enum mapping."
      ],
      "undo_check": "Owned undo restores both fade channels and gain animation. Verify native audio for clicks independently."
    },
    {
      "method": "v4.audio.effect.add",
      "steps": [
        "Insert an installed audio effect using full effectID into the AV fixture.",
        "Inspect both video and audio-component stacks."
      ],
      "expected_readback": [
        "One exact new native instance, correct audio component and effect order."
      ],
      "undo_check": "Owned undo removes only that new instance; compare all effect state and channel layout."
    },
    {
      "method": "v4.audio.effect.configure",
      "steps": [
        "Bind one EQ band frequency/Q/gain and compressor threshold/ratio to discovered paths.",
        "Write at explicit component-local times; independently inspect each."
      ],
      "expected_readback": [
        "Stored typed native values without inferred Hz/ms/dB scaling."
      ],
      "undo_check": "Owned undo restores complete AU parameter state, preset dirty flag and animation."
    },
    {
      "method": "v4.audio.apply_preset",
      "steps": [
        "Use a factory preset ID independently discovered in a native fixture.",
        "Apply to one of two identical compressor instances."
      ],
      "expected_readback": [
        "The requested presetID on the targeted fileUUID; inspect all preset side effects separately."
      ],
      "undo_check": "Owned undo restores the complete AU state, including pre-existing parameter animation."
    },
    {
      "method": "v4.audio.get_channel_map",
      "steps": [
        "Read a two-channel and a four-channel fixture.",
        "Compare source indices/enabled flags and role UID to native exported state."
      ],
      "expected_readback": [
        "Exactly one entry per source channel; no fabricated routing or stereo-group model."
      ],
      "undo_check": "Read only: no native mutation or undo entry."
    },
    {
      "method": "v4.audio.set_channel_map",
      "steps": [
        "Disable one source channel; inspect the exact clip.",
        "Reject wrong-length and nonboolean arrays before mutation."
      ],
      "expected_readback": [
        "Only the requested existing source enable flags change; groups and routing unchanged."
      ],
      "undo_check": "Owned undo restores the entire original channel map and audible channel output."
    },
    {
      "method": "v4.audio.set_role",
      "steps": [
        "With exactly one fixture library open, assign an existing audio role UID.",
        "Attempt a video role and an ambiguous multi-library role; require refusal."
      ],
      "expected_readback": [
        "Exact requested audio UID; video/caption roles and source-channel assignments unaffected."
      ],
      "undo_check": "Owned undo restores role/subrole graph and FCPXML role sources."
    },
    {
      "method": "v4.audio.ducking.plan",
      "steps": [
        "Provide exact music/dialogue clip identities and -12 dB duck amount.",
        "Inspect the plan and verify no native call/keyframe was submitted."
      ],
      "expected_readback": [

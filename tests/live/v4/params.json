    {
      "id": "Gaussian_catalog_typed_value",
      "fixture": "Gaussian built-in Motion filter on a trimmed disposable clip",
      "steps": [
        {
          "method": "v4.effect.catalog",
          "params": {
            "query": "Gaussian",
            "type": "filter",
            "offset": 0,
            "limit": 1
          },
          "expect": "Exact full effectID with ... prefix preserved; category/localized_name/stable_name/template_path/package_uuid/payload_available present. Page until next_offset is null; repeat page unchanged."
        },
        {
          "method": "v4.effect.add",
          "params": {
            "target": {
              "clip_id": "$clip"
            },
            "effect_id": "$catalog.effects[0].effectID"
          },
          "capture": "effect",
          "expect": "applied true, new unique native fileUUID; exactly one extra instance, same original order."
        },
        {
          "method": "v4.object.inspect",
          "params": {
